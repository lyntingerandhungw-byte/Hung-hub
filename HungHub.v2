local function toggleUI(show) Main.Visible = show; ToggleBtn.Visible = not show end
MinBtn.MouseButton1Click:Connect(function() toggleUI(false) end); MinBtn.TouchTap:Connect(function() toggleUI(false) end)
ClsBtn.MouseButton1Click:Connect(function() UI:Destroy() end); ClsBtn.TouchTap:Connect(function() UI:Destroy() end)
