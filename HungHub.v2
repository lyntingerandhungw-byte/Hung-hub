    local b = Instance.new("TextBox", Main); b.Size, b.Position, b.BackgroundColor3, b.TextColor3, b.Font, b.TextSize, b.Text, b.PlaceholderText = UDim2.new(0, 110, 0, 30), ps, Color3.fromRGB(22, 22, 28), Color3.fromRGB(255, 255, 255), Enum.Font.GothamBold, 11, tx, ph
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6); Instance.new("UIStroke", b).Color = Color3.fromRGB(45, 45, 55); return bendlocal function cBtn(tx, ps, cl)
    local b = Instance.new("TextButton", Main); b.Size, b.Position, b.BackgroundColor3, b.TextColor3, b.Font, b.TextSize, b.Text = UDim2.new(0, 110, 0, 30), ps, Color3.fromRGB(28, 24, 20), Color3.fromRGB(255, 215, 0), Enum.Font.GothamBold, 10, tx
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6); Instance.new("UIStroke", b).Color = cl or Color3.fromRGB(255, 215, 0); return bend
