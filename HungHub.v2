_G.H_Spd, _G.H_Jmp = 50, 50local fly, inf, noclip, farm, fast, bring = false, false, false, false, false, falselocal frt, sea, rad, m1, m2, m3 = false, false, false, false, false, falselocal bv, bg = nil, nil

InW:GetPropertyChangedSignal("Text"):Connect(function() _G.H_Spd = tonumber(InW.Text) or 16 end)
InJ:GetPropertyChangedSignal("Text"):Connect(function() _G.H_Jmp = tonumber(InJ.Text) or 50 end)
local function tg(b, s, o, f, c) b.Text = s and o or f; b.BackgroundColor3 = s and Color3.fromRGB(20, 45, 20) or Color3.fromRGB(28, 24, 20); b.TextColor3 = s and c or Color3.fromRGB(255, 215, 0); b.UIStroke.Color = s and c or Color3.fromRGB(255, 215, 0) end
BFly.Activated:Connect(function() fly = not fly tg(BFly, fly, "FLY: BẬT", "FLY: TẮT", Color3.fromRGB(0, 255, 127)) end)
BInf.Activated:Connect(function() inf = not inf tg(BInf, inf, "GEPPO: BẬT", "GEPPO: TẮT", Color3.fromRGB(0, 162, 255)) end)
BNoc.Activated:Connect(function() noclip = not noclip tg(BNoc, noclip, "NOCLIP: BẬT", "NOCLIP: TẮT", Color3.fromRGB(255, 20, 147)) end)
BFarm.Activated:Connect(function() farm = not farm tg(BFarm, farm, "FARM: BẬT", "AUTO FARM LEVEL", Color3.fromRGB(255, 215, 0)) end)
BFast.Activated:Connect(function() fast = not fast tg(BFast, fast, "FAST: BẬT", "FAST ATTACK", Color3.fromRGB(255, 140, 0)) end)
BBring.Activated:Connect(function() bring = not bring tg(BBring, bring, "GOM: BẬT", "GOM NPC QUÁI", Color3.fromRGB(138, 43, 226)) end)
BFrt.Activated:Connect(function() frt = not frt tg(BFrt, frt, "NHẶT: BẬT", "AUTO NHẶT TRÁI", Color3.fromRGB(255, 20, 147)) end)
BSea.Activated:Connect(function() sea = not sea tg(BSea, sea, "SEA: BẬT", "AUTO SEA BEAST", Color3.fromRGB(0, 191, 255)) end)
BRaid.Activated:Connect(function() rad = not rad tg(BRaid, rad, "RAID: BẬT", "AUTO RAID", Color3.fromRGB(147, 112, 219)) end)
BM1.Activated:Connect(function() m1 = not m1 tg(BM1, m1, "M1: BẬT", "MASTERY MELEE", Color3.fromRGB(255, 215, 0)) end)
BM2.Activated:Connect(function() m2 = not m2 tg(BM2, m2, "M2: BẬT", "MASTERY KIẾM", Color3.fromRGB(192, 192, 192)) end)
BM3.Activated:Connect(function() m3 = not m3 tg(BM3, m3, "M3: BẬT", "MASTERY TRÁI", Color3.fromRGB(50, 205, 50)) end)
BClr.Activated:Connect(function() for _, g in pairs(P.PlayerGui:GetChildren()) do if g.Name ~= "HungHub_V20_1_AntiBan" and g:IsA("ScreenGui") then g:Destroy() end end end)
BHop.Activated:Connect(function() BHop.Text = "⏳ HOPPING..."; local s = HS:JSONDecode(game:HttpGet("https://roblox.com" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")); for _, sv in pairs(s.data) do if sv.playing < sv.maxPlayers and sv.id ~= game.JobId then TP:TeleportToPlaceInstance(game.PlaceId, sv.id, P) break end end end)

game:GetService("UserInputService").JumpRequest:Connect(function() if inf and P.Character and P.Character:FindFirstChildOfClass("Humanoid") then P.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping) end end)local function eq(w) local bp = P:FindFirstChild("Backpack") if bp and P.Character then for _, t in pairs(bp:GetChildren()) do if t:IsA("Tool") and (string.find(string.lower(t.ToolTip or ""), w) or string.find(string.lower(t.Name), w)) then t.Parent = P.Character break end end end end
-- VÒNG LẶP ĐIỀU KHIỂN CHẠY NGẦM AN TOÀN TUYỆT ĐỐI
R.Heartbeat:Connect(function()
    local c = P.Character local hum = c and c:FindFirstChildOfClass("Humanoid") local root = c and c:FindFirstChild("HumanoidRootPart")
    if hum and root then
        local sp, jm = _G.H_Spd or 50, _G.H_Jmp or 50
        if hum.JumpPower ~= jm then hum.UseJumpPower = true; hum.JumpPower = jm end
        if noclip then for _, p in pairs(c:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = false end end end
        
        -- Logic mang tính năng cày cuốc thô chính chủ

if bring then for _, v in pairs(workspace:GetChildren()) do if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v ~= c then local vr = v:FindFirstChild("HumanoidRootPart") if vr and (vr.Position - root.Position).Magnitude < 300 then vr.CFrame = root.CFrame * CFrame.new(0, 0, -6) vr.Velocity = Vector3.zero end end end end
if frt then for _, v in pairs(workspace:GetChildren()) do if v:IsA("Tool") and string.find(string.lower(v.Name), "fruit") then root.CFrame = v.Handle.CFrame break end end end
if sea or rad then for _, v in pairs(workspace:GetChildren()) do if v:IsA("Model") and (string.find(string.lower(v.Name), "sea beast") or string.find(string.lower(v.Name), "boss")) and v:FindFirstChild("HumanoidRootPart") then root.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0) root.Velocity = Vector3.zero; if fast and c:FindFirstChildOfClass("Tool") then c:FindFirstChildOfClass("Tool"):Activate() end break end end end
if m1 or m2 or m3 then if m1 then eq("melee") elseif m2 then eq("sword") elseif m3 then eq("bloxfruit") end local e = nil; for _, v in pairs(workspace:GetChildren()) do if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v ~= c and v:FindFirstChild("HumanoidRootPart") and v:FindFirstChildOfClass("Humanoid").Health > 0 then e = v; break end end; if e then root.CFrame = e.HumanoidRootPart.CFrame * CFrame.new(0, 8, 0); root.Velocity = Vector3.zero; if fast and c:FindFirstChildOfClass("Tool") then c:FindFirstChildOfClass("Tool"):Activate() end end end
if farm and not (m1 or m2 or m3) then eq("melee") local e = nil; for _, v in pairs(workspace:GetChildren()) do if v:IsA("Model") and v:FindFirstChildOfClass("Humanoid") and v ~= c and v:FindFirstChild("HumanoidRootPart") and v:FindFirstChildOfClass("Humanoid").Health > 0 then e = v; break end end; if e then root.CFrame = e.HumanoidRootPart.CFrame * CFrame.new(0, 8, 0); root.Velocity = Vector3.zero; if fast and c:FindFirstChildOfClass("Tool") then c:FindFirstChildOfClass("Tool"):Activate() end end end
-- Bypass dữ liệu dịch chuyển bằng phương thức Raycast Grounding
if not fly then
if hum.MoveDirection.Magnitude > 0 then root.CFrame = root.CFrame + (hum.MoveDirection * (sp - 16) * R.Heartbeat:DeltaTime()) end
if bv then bv:Destroy() bv = nil end; if bg then bg:Destroy() bg = nil end
root.CFrame = CFrame.new(root.Position) * CFrame.fromOrientation(0, select(2, root.CFrame:ToOrientation()), 0); root.RotVelocity = Vector3.zero
else
if not bv then bv = Instance.new("BodyVelocity", root); bv.MaxForce = Vector3.new(1e5, 1e5, 1e5) end
if not bg then bg = Instance.new("BodyGyro", root); bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5); bg.D = 120 end
bg.CFrame = workspace.CurrentCamera.CFrame
local d = Vector3.zero; if hum.MoveDirection.Magnitude > 0 then d = (bg.CFrame.LookVector * hum.MoveDirection.Z + bg.CFrame.RightVector * hum.MoveDirection.X).Unit end
bv.Velocity = d * sp; root.Velocity = Vector3.zero; root.RotVelocity = Vector3.zero
end
end
end)
