-- ★ HƯNG HUB V20.1 - ULTIMATE NATIVE PREMIUM (ANTI-BAN & HORIZONTAL PRO LAYOUT) ★local P, R = game:GetService("Players").LocalPlayer, game:GetService("RunService")local TS, HS, TP = game:GetService("TweenService"), game:GetService("HttpService"), game:GetService("TeleportService")local UI = Instance.new("ScreenGui", P:WaitForChild("PlayerGui")); UI.ResetOnSpawn, UI.Name = false, "HungHub_V20_1_AntiBan"
-- CHẶN LUỒNG QUÉT CỦA SERVER (ANTI-BAN GHOST HOOK)local mt = getrawmetatable and getrawmetatable(game)if mt and setreadonly then
    setreadonly(mt, false)
    local oldIndex = mt.__index
    mt.__index = newcclosure(function(t, k)
        if tostring(t) == "Humanoid" and (k == "WalkSpeed" or k == "JumpPower") then
            return k == "WalkSpeed" and 16 or 50 -- Đánh lừa bộ quét thuộc tính trả về chỉ số gốc
        end
        return oldIndex(t, k)
    end)
    setreadonly(mt, true)end
