-- Thuật toán Hop Server Quét API
local function executeServerHop()
    local placeId = game.PlaceId
    local serversUrl = "https://roblox.com" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(serversUrl)) end)
    if success and result and result.data then
        for _, server in pairs(result.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(placeId, server.id, P)
                break
            end
        end
    else TeleportService:Teleport(placeId, P) end
end

BHopMoon.Activated:Connect(function() BHopMoon.Text = "⏳ DÒ TRĂNG TRÒN..."; executeServerHop() end)
BHopMirage.Activated:Connect(function() BHopMirage.Text = "⏳ DÒ ĐẢO ẢO ẢNH..."; executeServerHop() end)

--------------------------------------------------------
-- QUẢN LÝ VẬT LÝ NHÂN VẬT NGẦM (HEARTBEAT)
--------------------------------------------------------
_G.H_Spd, _G.H_Jmp = 50, 50
local fly, inf, noclip = false, false, false
local bv, bg = nil, nil

InW:GetPropertyChangedSignal("Text"):Connect(function() _G.H_Spd = tonumber(InW.Text) or 16 end)
InJ:GetPropertyChangedSignal("Text"):Connect(function() _G.H_Jmp = tonumber(InJ.Text) or 50 end)

local function tg(b, s, onT, offT, c)
    b.Text = s and onT or offT; b.BackgroundColor3 = s and Color3.fromRGB(20, 45, 20) or Color3.fromRGB(28, 24, 20)
    b.TextColor3 = s and c or Color3.fromRGB(255, 215, 0); b.UIStroke.Color = s and c or Color3.fromRGB(255, 215, 0)
end

BFly.Activated:Connect(function() fly = not fly tg(BFly, fly, "THUYỀN BAY: KHỞI HÀNH", "THUYỀN BAY (FLY): TẮT", Color3.fromRGB(0, 255, 127)) end)
BInf.Activated:Connect(function() inf = not inf tg(BInf, inf, "VÔ HẠN NHẢY: HOẠT ĐỘNG", "VÔ HẠN NHẢY (GEPPO): TẮT", Color3.fromRGB(0, 162, 255)) end)
BNoc.Activated:Connect(function() noclip = not noclip tg(BNoc, noclip, "XUYÊN TƯỜNG: KÍCH HOẠT", "XUYÊN TƯỜNG (NOCLIP): TẮT", Color3.fromRGB(255, 20, 147)) end)
BTp.Activated:Connect(function() local c = P.Character local r = c and c:FindFirstChild("HumanoidRootPart") if r then r.CFrame = r.CFrame + Vector3.new(0, 300, 0) end end)
BClr.Activated:Connect(function() for _, g in pairs(P.PlayerGui:GetChildren()) do if g.Name ~= "HungHub_TriEngine_V17" and g:IsA("ScreenGui") then g:Destroy() end end end)
game:GetService("UserInputService").JumpRequest:Connect(function() if inf and P.Character and P.Character:FindFirstChildOfClass("Humanoid") then P.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping) end end)

R.Heartbeat:Connect(function()
    local c = P.Character local hum = c and c:FindFirstChildOfClass("Humanoid") local root = c and c:FindFirstChild("HumanoidRootPart")
    if hum and root then
        local sp, jm = _G.H_Spd or 50, _G.H_Jmp or 50
        hum.WalkSpeed = 16
        if hum.JumpPower ~= jm then hum.UseJumpPower = true; hum.JumpPower = jm end
        if noclip then for _, p in pairs(c:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = false end end end
        if not fly then
            if hum.MoveDirection.Magnitude > 0 then root.CFrame = root.CFrame + (hum.MoveDirection * (sp - 16) * R.Heartbeat:DeltaTime()) end
            if bv then bv:Destroy(); bv = nil end; if bg then bg:Destroy(); bg = nil end
            root.CFrame = CFrame.new(root.Position) * CFrame.fromOrientation(0, select(2, root.CFrame:ToOrientation()), 0); root.RotVelocity = Vector3.zero
        else
            if not bv then bv = Instance.new("BodyVelocity", root); bv.MaxForce = Vector3.new(1e5, 1e5, 1e5) end
            if not bg then bg = Instance.new("BodyGyro", root); bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5); bg.D = 120 end
            bg.CFrame = workspace.CurrentCamera.CFrame
            local d = Vector3.zero; if hum.MoveDirection.Magnitude > 0 then d = (bg.CFrame.LookVector * hum.MoveDirection.Z + bg.CFrame.RightVector * hum.MoveDirection.X).Unit end
            bv.Velocity = d * sp; root.Velocity = Vector3.zero; root.RotVelocity = Vector3.zero
        end
    end
end)
