-- ★ HƯNG HUB V17 - ULTRA TRI-ENGINE (BANANA CAT x REALKID x MARU HUB ALL-IN-ONE) ★
local P, R = game:GetService("Players").LocalPlayer, game:GetService("RunService")
local TS = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local UI = Instance.new("ScreenGui", P:WaitForChild("PlayerGui")); UI.ResetOnSpawn, UI.Name = false, "HungHub_TriEngine_V17"

-- 1. NÚT TRÒN BẬT/TẮT LOGO HẢI TẶC LUFFY
local ToggleBtn = Instance.new("ImageButton", UI)
ToggleBtn.Size, ToggleBtn.Position = UDim2.new(0, 60, 0, 60), UDim2.new(0.02, 0, 0.15, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
ToggleBtn.Image = "rbxassetid://14457788410" 
ToggleBtn.Active, ToggleBtn.Draggable = true, true
Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)
Instance.new("UIStroke", ToggleBtn).Color = Color3.fromRGB(255, 215, 0)

-- 2. KHUNG MENU TO BANANA PREMIUM CỠ LỚN (490 x 420)
local Main = Instance.new("Frame", UI); Main.Size, Main.Position, Main.BackgroundColor3, Main.Draggable, Main.Active = UDim2.new(0, 490, 0, 420), UDim2.new(0.1, 0, 0.12, 0), Color3.fromRGB(12, 12, 14), true, true
Main.Visible = true
Instance.new("UIStroke", Main).Color = Color3.fromRGB(255, 215, 0)
Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 16)

ToggleBtn.Activated:Connect(function()
    if Main.Visible then
        local t = TS:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {Size = UDim2.new(0, 490, 0, 0)}) t:Play()
        t.Completed:Connect(function() if Main.Size.Y.Offset == 0 then Main.Visible = false end end)
    else Main.Visible = true; TS:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {Size = UDim2.new(0, 490, 0, 420)}):Play() end
end)

-- LOGO HƯNG HUB BIỂU THỊ KHI BẬT LÊN MÀN HÌNH
local ImageBanner = Instance.new("ImageLabel", Main)
ImageBanner.Size, ImageBanner.Position = UDim2.new(0, 80, 0, 80), UDim2.new(0.42, 0, 0, 45)
ImageBanner.Image = "rbxassetid://14457788410" -- Hiển thị logo khi bật lên
ImageBanner.BackgroundTransparency = 1
Instance.new("UICorner", ImageBanner).CornerRadius = UDim.new(1, 0)

local MainTitle = Instance.new("TextLabel", Main); MainTitle.Size, MainTitle.BackgroundTransparency = UDim2.new(1, 0, 0, 45), 1
MainTitle.Text = "★ HƯNG HUB - TRI-ENGINE PREMIUM V17 ★"
MainTitle.TextColor3, MainTitle.Font, MainTitle.TextSize = Color3.fromRGB(255, 215, 0), Enum.Font.GothamBold, 14

local function cBox(txt, pos, ph)
    local b = Instance.new("TextBox", Main); b.Size, b.Position, b.BackgroundColor3, b.TextColor3, b.Font, b.TextSize, b.Text, b.PlaceholderText = UDim2.new(0, 210, 0, 35), pos, Color3.fromRGB(22, 22, 28), Color3.fromRGB(255, 255, 255), Enum.Font.GothamBold, 12, txt, ph
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8); Instance.new("UIStroke", b).Color = Color3.fromRGB(45, 45, 55); return b
end
local function cBtn(txt, pos, clr)
    local b = Instance.new("TextButton", Main); b.Size, b.Position, b.BackgroundColor3, b.TextColor3, b.Font, b.TextSize, b.Text = UDim2.new(0, 210, 0, 35), pos, Color3.fromRGB(28, 24, 20), Color3.fromRGB(255, 215, 0), Enum.Font.GothamBold, 11, txt
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8); Instance.new("UIStroke", b).Color = clr or Color3.fromRGB(255, 215, 0); return b
end

-- --- THIẾT LẬP LAYOUT 2 CỘT TÍNH NĂNG ---
-- Cột Trái (Vật lý & Tải Động Thần Tốc)
local InW = cBox("50", UDim2.new(0.04, 0, 0, 135), "Tốc độ chạy bộ...")
local InJ = cBox("50", UDim2.new(0.04, 0, 0, 180), "Chỉ số nhảy cao...")
local BFly = cBtn("THUYỀN BAY (FLY): TẮT", UDim2.new(0.04, 0, 0, 225))
local BInf = cBtn("VÔ HẠN NHẢY (GEPPO): TẮT", UDim2.new(0.04, 0, 0, 270))
local BNoc = cBtn("XUYÊN TƯỜNG (NOCLIP): TẮT", UDim2.new(0.04, 0, 0, 315))
local BTp  = cBtn("TELEPORT TRỐN KẸT (300m)", UDim2.new(0.04, 0, 0, 360))

-- Cột Phải (Hợp nhất 3 Lõi Cày Cuốc Lớn: Banana, Realkid, Maru)
local BLoadBanana = cBtn("🐱 KÍCH HOẠT BANANA CAT HUB", UDim2.new(0.52, 0, 0, 135), Color3.fromRGB(255, 215, 0))
local BLoadReal   = cBtn("⚡ KÍCH HOẠT REALKID HUB FULL", UDim2.new(0.52, 0, 0, 180), Color3.fromRGB(0, 255, 127))
local BLoadMaru   = cBtn("🔥 KÍCH HOẠT MARU HUB PREMIUM", UDim2.new(0.52, 0, 0, 225), Color3.fromRGB(255, 69, 0))
local BHopMoon    = cBtn("🌕 HOP SERVER FULL MOON", UDim2.new(0.52, 0, 0, 270))
local BHopMirage  = cBtn("🏝 HOP SERVER MIRAGE ISLAND", UDim2.new(0.52, 0, 0, 315))
local BClr        = cBtn("🔥 XOÁ SẠCH UI GAME / TĂNG FPS", UDim2.new(0.52, 0, 0, 360), Color3.fromRGB(255, 0, 0))

BLoadBanana.BackgroundColor3 = Color3.fromRGB(45, 40, 20); BLoadReal.BackgroundColor3 = Color3.fromRGB(20, 45, 25); BLoadMaru.BackgroundColor3 = Color3.fromRGB(45, 20, 20)

